{
  "_comment": "DeepSpeed config for Qwen3.5 fine-tuning. Uses BF16 because Qwen3.5 weights exceed FP16 range.",
  "bf16": {
    "enabled": true
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0,
      "weight_decay": 0.01,
      "adam_w_mode": true,
      "betas": [
        0.9,
        0.95
      ]
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": 1e-06,
      "warmup_num_steps": 30,
      "total_num_steps": 300
    }
  },
  "zero_optimization": {
    "stage": 2,
    "stage3_gather_16bit_weights_on_model_save": true,
    "allgather_partitions": true,
    "allgather_bucket_size": 200000000.0,
    "overlap_comm": true,
    "reduce_scatter": true,
    "reduce_bucket_size": 200000000.0,
    "contiguous_gradients": true
  },
  "train_micro_batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 32,
  "gradient_clipping": 1.0,
  "steps_per_print": 50,
  "wall_clock_breakdown": false
}