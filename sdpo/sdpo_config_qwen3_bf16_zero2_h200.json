{
  "_comment": "ZeRO-2 BF16 for 2x H200: frozen Qwen3-8B target + trainable Qwen3-0.6B draft. Params stay on GPU. micro_bs 8 batches the prefix and the tree rollout.",
  "bf16": {
    "enabled": true
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0,
      "weight_decay": 0.01,
      "adam_w_mode": true,
      "betas": [0.9, 0.95],
      "torch_adam": true
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": 1e-6,
      "warmup_num_steps": 30,
      "total_num_steps": 303
    }
  },
  "zero_optimization": {
    "stage": 2,
    "allgather_partitions": true,
    "allgather_bucket_size": 200000000.0,
    "overlap_comm": true,
    "reduce_scatter": true,
    "reduce_bucket_size": 200000000.0,
    "contiguous_gradients": true
  },
  "train_micro_batch_size_per_gpu": 8,
  "gradient_accumulation_steps": 1,
  "gradient_clipping": 1.0,
  "steps_per_print": 10,
  "wall_clock_breakdown": false
}
